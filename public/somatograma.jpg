    <text x="182" y="20" text-anchor="middle" class="axis-label">-4</text>
    <!-- -3 -->
    <line x1="213" y1="30" x2="213" y2="40" class="axis-tick" stroke-width="1.2" />
    <text x="213" y="20" text-anchor="middle" class="axis-label">-3</text>
    <!-- -2 -->
    <line x1="244" y1="30" x2="244" y2="40" class="axis-tick" stroke-width="1.2" />
    <text x="244" y="20" text-anchor="middle" class="axis-label">-2</text>
    <!-- -1 -->
