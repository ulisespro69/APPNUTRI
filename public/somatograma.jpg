    <line x1="492" y1="574" x2="492" y2="564" class="axis-tick" stroke-width="1.2" />
    <text x="492" y="594" text-anchor="middle" class="axis-label">+6</text>
    <line x1="523" y1="574" x2="523" y2="564" class="axis-tick" stroke-width="1.2" />
    <text x="523" y="594" text-anchor="middle" class="axis-label">+7</text>
    <line x1="554" y1="574" x2="554" y2="564" class="axis-tick" stroke-width="1.2" />
    <text x="554" y="594" text-anchor="middle" class="axis-label">+8</text>
  </g>

  <!-- Left & Right Y Axis Ticks and Labels -->
  <!-- scaleY = 17.898, originY = 365, left = 34, right = 578 -->
  <!-- Labels at +16, +14, +12, +10, +8, +6, +4, +2, 0, -2, -4, -6, -8, -10 -->
