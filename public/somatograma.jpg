<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 612 612" width="612" height="612" style="background:#ffffff; font-family: Arial, Helvetica, sans-serif;">
  <defs>
    <style>
      .axis-tick { stroke: #000000; stroke-linecap: square; }
      .axis-label { fill: #000000; font-size: 11px; font-weight: bold; }
      .chart-arc { fill: none; stroke: #000000; stroke-width: 2.2; }
      .spine-solid { stroke: #000000; stroke-width: 1.5; }
      .spine-dashed { stroke: #000000; stroke-width: 1.2; stroke-dasharray: 6,4; }
      .apex-label { fill: #000000; font-size: 13px; font-weight: bold; letter-spacing: 0.5px; }
    </style>
  </defs>

  <!-- Outer Square Border -->
  <rect x="34" y="30" width="544" height="544" fill="#ffffff" stroke="#000000" stroke-width="2.5" />

  <!-- Reuleaux Curvilinear Somatochart Triangle (Carter & Heath) -->
  <!-- Vertices: Meso(306, 150.23), Endo(120, 472.39), Ecto(492, 472.39). Radius R = 372.0 -->
  <path d="M 120 472.39 A 372 372 0 0 0 492 472.39 A 372 372 0 0 0 306 150.23 A 372 372 0 0 0 120 472.39 Z" class="chart-arc" fill="#fcfcfc" />

  <!-- Axis 1: Vertical Axis (Mesomorphy) -->
  <line x1="306" y1="87" x2="306" y2="150.23" stroke="#000000" stroke-width="1" />
  <line x1="306" y1="150.23" x2="306" y2="365" class="spine-solid" />
  <line x1="306" y1="365" x2="306" y2="522.23" class="spine-dashed" />

  <!-- Axis 2: Endomorphy Diagonal & Bisector -->
  <line x1="73.5" y1="499.2" x2="120" y2="472.39" stroke="#000000" stroke-width="1" />
  <line x1="120" y1="472.39" x2="306" y2="365" class="spine-solid" />
  <line x1="306" y1="365" x2="498" y2="254" class="spine-dashed" />

  <!-- Axis 3: Ectomorphy Diagonal & Bisector -->
  <line x1="538.5" y1="499.2" x2="492" y2="472.39" stroke="#000000" stroke-width="1" />
  <line x1="492" y1="472.39" x2="306" y2="365" class="spine-solid" />
  <line x1="306" y1="365" x2="114" y2="254" class="spine-dashed" />

  <!-- Apex Labels -->
  <g id="apex-label-mesomorphy">
    <rect x="232" y="116" width="148" height="26" rx="6" fill="#ffffff" stroke="#000000" stroke-width="1.6" />
    <circle cx="248" cy="129" r="3.5" fill="#0284c7" />
    <text x="311" y="133.5" text-anchor="middle" class="apex-label">MESOMORFISMO</text>
  </g>
  <g id="apex-label-endomorphy">
    <rect x="50" y="500" width="148" height="26" rx="6" fill="#ffffff" stroke="#000000" stroke-width="1.6" />
    <circle cx="66" cy="513" r="3.5" fill="#d97706" />
    <text x="129" y="517.5" text-anchor="middle" class="apex-label">ENDOMORFISMO</text>
  </g>
  <g id="apex-label-ectomorphy">
    <rect x="414" y="500" width="148" height="26" rx="6" fill="#ffffff" stroke="#000000" stroke-width="1.6" />
    <circle cx="430" cy="513" r="3.5" fill="#7c3aed" />
    <text x="493" y="517.5" text-anchor="middle" class="apex-label">ECTOMORFISMO</text>
  </g>

  <!-- Top X Axis Ticks and Labels -->
  <!-- scaleX = 31.0, originX = 306, y = 30 -->
  <!-- -8 to +8 -->
  <g class="axis-ticks-top">
    <!-- -8 -->
    <line x1="58" y1="30" x2="58" y2="40" class="axis-tick" stroke-width="1.2" />
    <text x="58" y="20" text-anchor="middle" class="axis-label">-8</text>
    <!-- -7 -->
    <line x1="89" y1="30" x2="89" y2="40" class="axis-tick" stroke-width="1.2" />
