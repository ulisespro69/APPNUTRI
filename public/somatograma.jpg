    <line x1="578" y1="78.6" x2="568" y2="78.6" class="axis-tick" stroke-width="1.2" />
    <text x="26" y="82.6" text-anchor="end" class="axis-label">+16</text>
    <text x="586" y="82.6" text-anchor="start" class="axis-label">+16</text>

    <!-- +14 (y = 114.4) -->
