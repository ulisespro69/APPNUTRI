    <text x="275" y="20" text-anchor="middle" class="axis-label">-1</text>
    <!-- 0 -->
    <line x1="306" y1="30" x2="306" y2="40" class="axis-tick" stroke-width="1.4" />
    <text x="306" y="20" text-anchor="middle" class="axis-label">0</text>
    <!-- +1 -->
    <line x1="337" y1="30" x2="337" y2="40" class="axis-tick" stroke-width="1.2" />
    <text x="337" y="20" text-anchor="middle" class="axis-label">+1</text>
    <!-- +2 -->
    <line x1="368" y1="30" x2="368" y2="40" class="axis-tick" stroke-width="1.2" />
    <text x="368" y="20" text-anchor="middle" class="axis-label">+2</text>
    <!-- +3 -->
    <line x1="399" y1="30" x2="399" y2="40" class="axis-tick" stroke-width="1.2" />
    <text x="399" y="20" text-anchor="middle" class="axis-label">+3</text>
    <!-- +4 -->
    <line x1="430" y1="30" x2="430" y2="40" class="axis-tick" stroke-width="1.2" />
    <text x="430" y="20" text-anchor="middle" class="axis-label">+4</text>
    <!-- +5 -->
    <line x1="461" y1="30" x2="461" y2="40" class="axis-tick" stroke-width="1.2" />
    <text x="461" y="20" text-anchor="middle" class="axis-label">+5</text>
