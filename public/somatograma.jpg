    <text x="306" y="594" text-anchor="middle" class="axis-label">0</text>
    <line x1="337" y1="574" x2="337" y2="564" class="axis-tick" stroke-width="1.2" />
    <text x="337" y="594" text-anchor="middle" class="axis-label">+1</text>
    <line x1="368" y1="574" x2="368" y2="564" class="axis-tick" stroke-width="1.2" />
    <text x="368" y="594" text-anchor="middle" class="axis-label">+2</text>
    <line x1="399" y1="574" x2="399" y2="564" class="axis-tick" stroke-width="1.2" />
    <text x="399" y="594" text-anchor="middle" class="axis-label">+3</text>
    <line x1="430" y1="574" x2="430" y2="564" class="axis-tick" stroke-width="1.2" />
    <text x="430" y="594" text-anchor="middle" class="axis-label">+4</text>
    <line x1="461" y1="574" x2="461" y2="564" class="axis-tick" stroke-width="1.2" />
