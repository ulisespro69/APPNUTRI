    <line x1="578" y1="257.6" x2="568" y2="257.6" class="axis-tick" stroke-width="1.2" />
    <text x="26" y="261.6" text-anchor="end" class="axis-label">+6</text>
    <text x="586" y="261.6" text-anchor="start" class="axis-label">+6</text>

    <!-- +4 (y = 293.4) -->
    <line x1="34" y1="293.4" x2="44" y2="293.4" class="axis-tick" stroke-width="1.2" />
    <line x1="578" y1="293.4" x2="568" y2="293.4" class="axis-tick" stroke-width="1.2" />
    <text x="26" y="297.4" text-anchor="end" class="axis-label">+4</text>
