    <line x1="578" y1="114.4" x2="568" y2="114.4" class="axis-tick" stroke-width="1.2" />
    <text x="26" y="118.4" text-anchor="end" class="axis-label">+14</text>
    <text x="586" y="118.4" text-anchor="start" class="axis-label">+14</text>

    <!-- +12 (y = 150.2) -->
    <line x1="34" y1="150.2" x2="44" y2="150.2" class="axis-tick" stroke-width="1.2" />
    <line x1="578" y1="150.2" x2="568" y2="150.2" class="axis-tick" stroke-width="1.2" />
    <text x="26" y="154.2" text-anchor="end" class="axis-label">+12</text>
    <text x="586" y="154.2" text-anchor="start" class="axis-label">+12</text>

    <!-- +10 (y = 186.0) -->
    <line x1="34" y1="186.0" x2="44" y2="186.0" class="axis-tick" stroke-width="1.2" />
    <line x1="578" y1="186.0" x2="568" y2="186.0" class="axis-tick" stroke-width="1.2" />
    <text x="26" y="190.0" text-anchor="end" class="axis-label">+10</text>
    <text x="586" y="190.0" text-anchor="start" class="axis-label">+10</text>

    <!-- +8 (y = 221.8) -->
    <line x1="34" y1="221.8" x2="44" y2="221.8" class="axis-tick" stroke-width="1.2" />
    <line x1="578" y1="221.8" x2="568" y2="221.8" class="axis-tick" stroke-width="1.2" />
    <text x="26" y="225.8" text-anchor="end" class="axis-label">+8</text>
    <text x="586" y="225.8" text-anchor="start" class="axis-label">+8</text>

